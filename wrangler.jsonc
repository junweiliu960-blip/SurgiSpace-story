{
  "name": "surgispace-story",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "account_id": "b9295afdcde27057e7ba8216bcb5ff6c",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surgispace-story-public-saves",
      "database_id": "65cf3856-69cb-4fc9-9979-8c7931ab4184"
    }
  ]
}
